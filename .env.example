# Base URL prefixed to every real API request made via src/api/client.ts.
# Leave unset (or empty) to call same-origin paths like /api/v1/... — e.g.
# when this frontend is served behind the same host/proxy as the backend.
#
# For local development against hxscyprodz/ZimReg_Backend running with
# `bun run start:dev` (defaults to port 3000 unless PORT is set in its .env):
# VITE_API_BASE_URL=http://localhost:3000
#
# Note: this backend authenticates with httpOnly session cookies, not a
# Bearer token — apiRequest() sends credentials: 'include' automatically,
# so nothing else needs configuring here for auth to work.
VITE_API_BASE_URL=

# Supabase project used for client-side document uploads (birth certificate
# and National ID application photos). The frontend uploads files directly
# to Supabase Storage and sends the resulting public URL to our own
# backend — the backend never receives or proxies the file itself.
#
# VITE_SUPABASE_ANON_KEY is meant to be public — Supabase's anon key is
# safe to ship in a client bundle by design. What actually controls access
# is the Storage bucket's Row Level Security policies on the Supabase
# project, which must be configured separately (see README).
#
# IMPORTANT: use the Project URL (Project Settings -> API -> Project URL),
# NOT the direct Postgres connection string and NOT the S3-compatible
# storage endpoint — those are different things Supabase also gives you,
# for different purposes, and neither works here.
#   Correct:   VITE_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
#   Wrong:     VITE_SUPABASE_URL=postgres://postgres:PASSWORD@db.abcdefghijklmnop.supabase.co:5432/postgres
#   Wrong:     VITE_SUPABASE_URL=https://abcdefghijklmnop.storage.supabase.co/storage/v1/s3
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Name of the Supabase Storage bucket documents are uploaded into — just
# the bucket's plain name (e.g. "application-documents"), not a URL.
# Defaults to "application-documents" if left unset.
VITE_SUPABASE_STORAGE_BUCKET=
